# Required for LLM features (brand, content, sentiment, chat, etc.)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Required for logo generation (SDXL via Replicate)
REPLICATE_API_TOKEN=
REPLICATE_LOGO_MODEL=stability-ai/sdxl
SDXL_GUIDANCE_SCALE=8.0
SDXL_INFERENCE_STEPS=35
MAX_LOGO_ATTEMPTS=3

# Server
PORT=8000
DEBUG=false

# Comma-separated browser origins for CORS (defaults include localhost:5173 and :3000)
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
